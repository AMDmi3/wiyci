<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Projects - wiyci</title>
	<link rel="stylesheet" href="/static/main.[     hash     ].css">
</head>
<body>

<header class="header"><div class="container">
<nav class="navbar">
	<div class="navbar-brand">
		<a href="/"><strong title="The World Is Your CI">wiyci</strong></a>
	</div>
	<ul class="navbar-menu"><li class="navbar-item is-active"><a href="/projects" aria-current="true">Projects</a></li>
	</ul>
</nav>
</div></header>

<main class="main"><div class="container">

<h1>Projects</h1>


<form action="/projects" method="GET" class="search-form">
	<input type="text" name="search" placeholder="project name, e.g. &quot;firefox&quot;" value="">
	<input type="submit" value="Go">
</form>


<p>1 project found</p>
<table class="projects-table">
	<thead>
		<tr>
			<th>Project</th>
			<th>Latest version(s)</th>
			<th>Issues (latest)</th>
			<th>Issues (overall)</th>
		</tr>
	</thead>
	<tbody>
	<tr class="">
		<td><a href="/project/firefox">firefox</a></td>
		<td></td>
		<td>
			<dl class="projects-table__issues-list">
			</dl>
		</td>
		<td>
			<dl class="projects-table__issues-list">
			</dl>
		</td>
	</tr>
	</tbody>
</table>


</div></main>

